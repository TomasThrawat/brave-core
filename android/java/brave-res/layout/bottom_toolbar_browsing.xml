<org.chromium.chrome.browser.toolbar.bottom.BrowsingModeBottomToolbarLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_toolbar_browsing"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_vertical"
    android:layout_gravity="top|center_horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Retain native views required by Chromium coordinators, but keep them out of the minimal UI. -->
    <org.chromium.chrome.browser.toolbar.BraveHomeButton
        android:id="@+id/bottom_home_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:tint="#FFFFFF"
        android:contentDescription="@string/accessibility_toolbar_btn_home"
        style="@style/SplitToolbarButton" />

    <include
        layout="@layout/brave_bookmark_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <org.chromium.chrome.browser.toolbar.bottom.SearchAccelerator
        android:id="@+id/search_accelerator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@string/accessibility_toolbar_btn_search_accelerator"
        app:srcCompat="@drawable/ic_search_21dp" />

    <include layout="@layout/brave_bottom_new_tab_button" />

    <ImageButton
        android:id="@+id/bottom_downloads_button"
        style="@style/SplitToolbarButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_download"
        android:scaleType="center"
        android:contentDescription="@string/menu_downloads"
        app:tint="#FFFFFF" />

    <org.chromium.chrome.browser.toolbar.TabSwitcherButtonView
        android:id="@+id/bottom_tab_switcher_button"
        style="@style/SplitToolbarButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="visible"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF"
        app:menuMaxWidth="@dimen/tab_switcher_menu_width"
        app:menuVerticalOverlapAnchor="false" />

    <ImageButton
        android:id="@+id/bottom_shields_button"
        style="@style/SplitToolbarButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_shield_done_filled"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_shields"
        app:tint="#FFFFFF" />

    <include
        layout="@layout/bottom_toolbar_menu_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</org.chromium.chrome.browser.toolbar.bottom.BrowsingModeBottomToolbarLinearLayout>
